      "exercises": "40 records, ~4.7 KB: UDP truncation and TCP fallback for node:dns, a sizeable DoH answer, 40-way intersection",
      "large": true
    },
    "low-ttl.dns-test.triauthdemo.org": {
      "ttl": 60,
      "records": {
        "TXT": [
          "name Low TTL"
        ]
      },
      "exercises": "TTL 60: ttl bound, CachingResolver remaining TTL"
    },
    "nodata.dns-test.triauthdemo.org": {
      "records": {
        "A": [
          "255.255.255.255"
        ]
      },
      "queries": {
        "A": {
          "doh": {
            "values": [
              "255.255.255.255"
            ]
          },
          "node": "reject",
          "multi": {
            "values": [
              "255.255.255.255"
            ]
          }
        }
      },
      "exercises": "name with no TXT: NODATA -> []; A query positive on DoH, rejected by node:dns (TXT only)"
    },
    "nxdomain.dns-test.triauthdemo.org": {
      "records": {},
      "exercises": "absent name under a Cloudflare zone: NOERROR with no answer -> []"
    },
    "alias.dns-test.triauthdemo.org": {
      "records": {
        "CNAME": "plain.dns-test.triauthdemo.org"
      },
      "expect": {
        "doh": {
          "values": []
        },
        "node": {
          "valuesOf": "plain.dns-test.triauthdemo.org"
        },
        "multi": {
          "values": []
        }
      },
      "queries": {
        "CNAME": {
          "doh": {
            "values": [
              "plain.dns-test.triauthdemo.org"
            ]
          },
          "node": "reject",
          "multi": {
            "values": [
              "plain.dns-test.triauthdemo.org"
            ]
          }
        }
      },
      "exercises": "CNAME alias: DoH answers carry the target name and are filtered out; node:dns follows the CNAME"
    },
    "*.wild.dns-test.triauthdemo.org": {
      "query": "anything.wild.dns-test.triauthdemo.org",
      "records": {
        "TXT": [
          "name Wildcard"
        ]
      },
      "exercises": "wildcard synthesis: the answer carries the queried name; DNSSEC wildcard proof"
    }
  },
  "external": {
    "nxdomain.dns-test.invalid": {
      "records": {},
      "exercises": "true NXDOMAIN (Status 3)"
    },
    "dnssec-failed.org": {
      "expect": {
        "doh": "reject",
        "node": "reject-or-resolve",
        "multi": "reject",
        "resolveConfig": 110
      },
      "exercises": "broken DNSSEC chain: SERVFAIL from validating resolvers"
    },
    "github.com": {
      "optional": true,
      "dnssec": false,
      "expect": {
        "doh": {
          "minRecords": 1
        },
        "node": {
          "minRecords": 1
        },
        "multi": {
          "minRecords": 1
        }
      },
      "exercises": "unsigned zone: dnssec false on real answers"
    }
