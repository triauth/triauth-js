{
  "_comment": "Records published once under dns-test.triauthdemo.org (Cloudflare-hosted, DNSSEC-signed through the DS of triauthdemo.org) for test/internals/test_resolvers_zone.js. TXT strings are LOGICAL record contents - exactly what Triauth.Resolvers.Base#resolve() must return; the published (BIND) form escapes quotes and backslashes and renders non-ASCII as \\DDD. Expectations default to: values = records.TXT (as a set), 0 < ttl <= ttl (300 unless given), dnssec true on DoH resolvers and undefined on node:dns; 'large' marks an RRset a truncating system resolver cannot deliver in full (node:dns and default-composition cells go pending, with a warning, when that is the case); 'expect' overrides per resolver kind (doh | node | multi) with values / valuesOf / minRecords / reject / reject-or-resolve. Zone preconditions: every record DNS-only (grey cloud), CNAME flattening 'root only'. Any change bumps 'version' and the apex 'zone-version' record; negative answers for a not-yet-published name stay cached at public resolvers for up to 1800 s (SOA minimum).",
  "version": 1,
  "zone": "dns-test.triauthdemo.org",
  "defaults": {
    "ttl": 300,
    "dnssec": true
  },
  "names": {
    "dns-test.triauthdemo.org": {
      "records": {
        "TXT": [
          "triauth auth.dns-test.triauthdemo.org",
          "v=spf1 -all",
          "zone-version 1"
        ]
      },
      "config": [
        {
          "key": "triauth",
          "value": "auth.dns-test.triauthdemo.org",
          "options": {}
        },
        {
          "key": "zone-version",
          "value": "1",
          "options": {}
        }
      ],
      "exercises": "subtree apex; config-style record; non-protocol record ignored by resolveConfig; version marker for the preflight"
    },
    "plain.dns-test.triauthdemo.org": {
      "records": {
        "TXT": [
          "name Plain Baseline"
        ]
      },
      "config": [
        {
          "key": "name",
          "value": "Plain Baseline",
          "options": {}
        }
      ],
      "exercises": "ASCII baseline; CNAME target; CachingResolver subject"
    },
    "set.dns-test.triauthdemo.org": {
      "records": {
        "TXT": [
          "item alpha",
          "item beta",
          "item gamma",
          "item delta"
        ]
      },
      "exercises": "RRset of four: set equality, order independence, MultiResolver intersection"
    },
    "utf8.dns-test.triauthdemo.org": {
      "records": {
        "TXT": [
          "name Frédéric Łukasiewicz",
          "city 東京 Zürich",
          "emoji 😀 4-byte"
        ]
      },
      "config": [
        {
          "key": "name",
          "value": "Frédéric Łukasiewicz",
          "options": {}
        },
        {
          "key": "city",
          "value": "東京 Zürich",
          "options": {}
        }
      ],
      "exercises": "2/3/4-byte UTF-8: \\DDD decoding (Cloudflare, DnsSb), logical pass-through (Google), octet re-decode (NodeDns); resolveConfig drops the emoji record (not a Normal String)"
    },
    "escapes.dns-test.triauthdemo.org": {
      "records": {
        "TXT": [
          "quote say \"hi\" back\\slash"
        ]
      },
      "config": [
        {
          "key": "quote",
          "value": "say \"hi\" back\\slash",
          "options": {}
        }
      ],
      "exercises": "presentation escapes \\\" and \\\\ decoded in one pass"
    },
    "punct.dns-test.triauthdemo.org": {
      "records": {
        "TXT": [
          "punct a;b#c=d:e f=g"
        ]
      },
      "config": [
        {
          "key": "punct",
          "value": "a;b#c=d:e",
          "options": {
            "f": "g"
          }
        }
      ],
      "exercises": "; # = : inside the value; trailing option run f=g peeled, c=d inside a value token kept"
    },
    "long.dns-test.triauthdemo.org": {
      "records": {
        "TXT": [
          "long "
        ]
      },
      "exercises": "405 octets: two character-strings on the wire, concatenated with no separator"
    },
